#!/bin/sh
# Blocks a commit when `toolbelt dotfiles check` finds secret-looking content in
# this (public) repo. Findings are reported as path:line:rule; the matched text
# is never printed. Mark a deliberate false positive with `tt:allow-secret`.
# Activated by `tt dotfiles link`, which sets core.hooksPath to .githooks.
if ! command -v toolbelt >/dev/null 2>&1; then
  echo "pre-commit: 'toolbelt' is not on PATH, so secrets cannot be scanned." >&2
  exit 1
fi
exec toolbelt dotfiles check "$(git rev-parse --show-toplevel)"
